{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"strict": true,
		"skipLibCheck": true,
		"rootDirs": [".", "./.svelte-kit/types", "./.houdini/types"],
		"paths": {
			"$houdini": ["./.houdini"],
			"$houdini/*": ["./.houdini/*"]
		}
	},
	"include": ["src/**/*.ts", "src/**/*.js", "src/**/*.svelte", "vite.config.ts", ".houdini/**/*.ts"],
	"exclude": ["node_modules/**"]
}
